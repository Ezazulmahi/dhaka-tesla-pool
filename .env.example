# Copy to .env before `docker compose up`. Never commit the real .env.

# Postgres (the db container creates this user/database on first start)
POSTGRES_USER=tesla
POSTGRES_PASSWORD=tesla
POSTGRES_DB=dhaka_tesla_pool

# REQUIRED. Signs session tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string
JWT_EXPIRES_IN=7d
COOKIE_SECURE=false
LOG_LEVEL=info

# Seed the story cast (Jashim & Bullet, Nusrat, Rafiq, Shirin, Kamal & Toofan) on start.
RUN_SEED=true
SEED_PASSWORD=bullet123

# Host ports
WEB_PORT=3000
API_PORT=4000
DB_PORT=5432
