# Copy to .env for local (non-Docker) development. Never commit real secrets.
NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://tesla:tesla@localhost:5432/dhaka_tesla_pool
# Used only by `npm test` (the suite truncates tables, so keep it separate).
TEST_DATABASE_URL=postgres://tesla:tesla@localhost:5432/dhaka_tesla_pool_test
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
# true when served over HTTPS (production)
COOKIE_SECURE=false
LOG_LEVEL=info
# Password given to every seeded demo user (Jashim, Nusrat, Rafiq, ...)
SEED_PASSWORD=bullet123
